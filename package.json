        "@lucide/vue": "^1.35.0",
        "@vueuse/core": "^14.4.0",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.2.0",
        "pusher-js": "^8.6.0",
        "shiki": "^4.4.3",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.42",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
